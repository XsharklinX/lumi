<?xml version="1.0" encoding="utf-8"?>
<!-- Widget mosaico: dos filas de fotos; la tercera columna solo se ve si cabe. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_mosaic_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/tile0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_photo_label"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_tile_empty" />

        <ImageView
            android:id="@+id/tile1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_photo_label"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_tile_empty" />

        <ImageView
            android:id="@+id/tile2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_photo_label"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_tile_empty" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/tile3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_photo_label"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_tile_empty" />

        <ImageView
            android:id="@+id/tile4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_photo_label"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_tile_empty" />

        <ImageView
            android:id="@+id/tile5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_photo_label"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_tile_empty" />
    </LinearLayout>
</LinearLayout>
