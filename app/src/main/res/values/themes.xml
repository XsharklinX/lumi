<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="lumi_bg">#0E0E13</color>
    <color name="lumi_brand">#5B3DF5</color>

    <style name="Theme.Lumi" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/lumi_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Mientras arranca: el logo animado sobre el fondo de la app, y luego el tema normal. -->
    <style name="Theme.Lumi.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/lumi_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="postSplashScreenTheme">@style/Theme.Lumi</item>
    </style>
</resources>
